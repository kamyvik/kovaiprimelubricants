# ==============================================================================
# STRICT SECURITY GUARD: KOVAI PRIME LUBRICANTS DATA STORE
# Denies all direct HTTP/HTTPS browser access to data files
# Only server-side backend scripts (PHP / Python) can access these files locally
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
